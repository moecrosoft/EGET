# LiteLLM gateway (self-hosted via docker-compose)
LITELLM_BASE_URL=http://localhost:4000   # e.g. http://localhost:4000 or http://litellm:4000 in-compose
# REQUIRED (not optional) — the app fails to start without it, and the litellm
# proxy container enforces it as the only client auth in front of your real
# provider API keys. Generate one with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-dummy-key
GROQ_API_KEY=dummy
OPENROUTER_API_KEY=dummy
ANTHROPIC_API_KEY=dummy
OPENAI_API_KEY=dummy

# Vector DB (self-hosted via docker-compose)
QDRANT_URL=http://localhost:6333         # e.g. http://localhost:6333

# Cache
UPSTASH_REDIS_REST_URL=https://dummy.upstash.io
UPSTASH_REDIS_REST_TOKEN=dummy

# Memory
MEM0_API_KEY=dummy                       # if hosted; omit/replace per Task 10's local-config finding

# Checkpointing
AGENT_SQLITE_PATH=./data/checkpoints.db  # e.g. ./data/checkpoints.db

# Node backend integration
NODE_BACKEND_BASE_URL=http://localhost:3000  # e.g. http://localhost:3000

# Service
AGENT_SERVICE_PORT=8000
AGENT_LOG_LEVEL=info
