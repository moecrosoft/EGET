# --- Required for the real AI agent (powers POST /api/chat, backend/src/agent.js) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- For Arjun's agentic loop (backend/src/arjunAgent.js) ---
# Two separate LLM providers are intentional: the generic chat agent above
# runs on Anthropic, Arjun's persona-specific agent runs on Groq. Get a free
# key at https://console.groq.com/keys. Not currently exposed via an API
# route (the AI playground it powered was removed) — kept for whoever
# re-wires it to a route later.
GROQ_API_KEY=gsk_your-key-here
# Optional — defaults to openai/gpt-oss-20b if unset.
GROQ_MODEL=openai/gpt-oss-20b

# --- Optional: without this the app runs on realistic mock LTA data ---
# Get one free in ~2 minutes: https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=your-lta-account-key-here

# --- Server ---
PORT=8787

# How often (ms) the proactive monitor sweeps live disruptions against
# saved commuter profiles. Keep this modest to respect LTA rate limits.
MONITOR_INTERVAL_MS=300000

# --- Optional: Arjun's journey planner (cycle+LRT vs bus-only) needs this ---
# Free registration at https://www.onemap.gov.sg/apidocs/. Token expires
# after 3 days — re-fetch from the login endpoint when it does.
ONEMAP_TOKEN=
